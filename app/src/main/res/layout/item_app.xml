<?xml version="1.0" encoding="utf-8"?>
<!-- One home tile: Apple TV 300x180px app icon (150x90dp, r12dp). Sized per column count
     and scaled on focus (370x222px, scale ~1.2333x with elevation and soft drop shadow). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="@dimen/tvos_icon_w"
        android:layout_height="@dimen/tvos_icon_h"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:elevation="2dp"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/tvos_label_primary"
            android:textSize="@dimen/tvos_text_caption2"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />
    </FrameLayout>

    <!-- App name under the focused icon (tvOS Caption 1 semibold); hidden per request. -->
    <TextView
        android:id="@+id/name"
        android:layout_width="@dimen/tvos_icon_w"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal|top"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />
</FrameLayout>
