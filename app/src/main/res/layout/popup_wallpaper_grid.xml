<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV tvOS 18 Wallpaper Visual Grid Picker Modal -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallpaperPickerScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D906060A"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top Header Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:text="WALLPAPERS"
                android:textColor="#80FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/wallpaperFocusedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="Chiikawa"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/wallpaperHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Press OK to apply • BACK to exit"
                android:textColor="#66FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Horizontal RecyclerView for cards -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wallpaperRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="38dp"
            android:paddingEnd="38dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:orientation="horizontal"
            android:descendantFocusability="afterDescendants" />

    </LinearLayout>
</FrameLayout>
