<?xml version="1.0" encoding="utf-8"?>
<!-- Menu bar control (capsule inside the menu bar platter): frosted glass until focused, then solid white. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tvos_fill_secondary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17FFFFFF" />
            <stroke android:width="0.5dp" android:color="#1AFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
