<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS focus for menu bar pills: gentle 1.03x scale with no elevation shadow box -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.03" android:duration="180" android:interpolator="@interpolator/tvos_spring" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.03" android:duration="180" android:interpolator="@interpolator/tvos_spring" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="180" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="150" android:interpolator="@interpolator/tvos_ease" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="150" android:interpolator="@interpolator/tvos_ease" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="150" android:valueType="floatType" />
        </set>
    </item>
</selector>
