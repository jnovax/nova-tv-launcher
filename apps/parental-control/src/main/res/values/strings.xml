    <string name="kid_gate_title">Xác thực Phụ huynh</string>
    <string name="kid_gate_body">FamilyTime được bảo vệ bằng mã OTP. Bấm phím Back trên remote để quay lại màn hình chính TV.</string>
    <string name="kid_gate_exit">Thoát về màn hình TV</string>

    <!-- Streamlined Onboarding -->
    <string name="onboarding_title">Thiết lập FamilyTime trên TV</string>
    <string name="permissions_step_title">1. Cấp quyền hệ thống</string>
    <string name="permissions_step_body">FamilyTime cần 2 quyền bên dưới để bảo vệ thời gian xem TV của các con. Bấm từng nút để mở Cài đặt TV, bật quyền cho FamilyTime, rồi bấm Back trên remote để quay lại đây.</string>
    <string name="perm_accessibility_granted">Hỗ trợ tiếp cận: Đã kết nối ✓</string>
    <string name="perm_accessibility_needed">Hỗ trợ tiếp cận: Chưa bật</string>
    <string name="perm_usage_granted">Truy cập dữ liệu sử dụng: Đã cấp ✓</string>
    <string name="perm_usage_needed">Truy cập dữ liệu sử dụng: Chưa cấp</string>
    <string name="parent_otp_step_title">2. Thiết lập mã OTP Phụ huynh</string>
    <string name="parent_qr_body">Mở Google Authenticator trên điện thoại, quét mã QR này và nhập ngay 6 số OTP đang hiển thị để kích hoạt.</string>
    <string name="recovery_codes_step_title">3. Lưu mã phục hồi khẩn cấp</string>
    <string name="recovery_codes_body">Dùng điện thoại chụp lại màn hình này để lưu 6 mã dự phòng. Mỗi mã dùng được 1 lần khi bạn đổi hoặc mất điện thoại.</string>
